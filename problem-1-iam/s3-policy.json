
{
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "ListAllBuckets",
        "Effect": "Allow",
        "Action": "s3:ListAllMyBuckets",
        "Resource": "*"
      },
      {
        "Sid": "ListMediaBucket",
        "Effect": "Allow",
        "Action": "s3:ListBucket",
        "Resource": "arn:aws:s3:::xyz-media"
      },
      {
        "Sid": "ReadWriteMediaObjects",
        "Effect": "Allow",
        "Action": [
          "s3:GetObject",
          "s3:PutObject"
        ],
        "Resource": "arn:aws:s3:::xyz-media/*"
      },
      {
        "Sid": "DenyBucketDeletionAndPolicyChanges",
        "Effect": "Deny",
        "Action": [
          "s3:DeleteBucket",
          "s3:PutBucketPolicy",
          "s3:DeleteBucketPolicy"
        ],
        "Resource": "arn:aws:s3:::xyz-media"
      }
    ]
  } 